# Sealero — environment template for deployment and self-hosting.
# Copy to .env for local dev, or set the same names in Vercel / Docker.
# NEVER put real secrets in this file. This file is safe to commit.
# Required at startup unless marked optional. See System Design §8.

# --- Database (required) ---
# Postgres connection string (Neon or self-hosted Postgres).
# On Vercel, the Marketplace injects the same value as POSTGRES_URL;
# the server reads DATABASE_URL first and falls back to POSTGRES_URL,
# so setting DATABASE_URL is optional there but explicit is better.
DATABASE_URL=postgresql://user:password@host:5432/neondb?sslmode=require

# --- Server identity (optional, default: Sealero) ---
SERVER_NAME=Sealero

# --- JWT, RS256 (all four required) ---
# Generate a key pair with the commands at the bottom of this file.
# Keep the private key out of the repo; the public key file must be
# JWKS JSON whose keys array contains the JWT_ACTIVE_KID.
# JWT_ISSUER must be the public HTTPS API origin, no path or trailing slash.
# On Vercel, files cannot hold the private key: set JWT_PRIVATE_KEY to the
# PEM content instead (real newlines, not \n escapes) and the server writes
# it to /tmp at cold start. The public JWKS is bundled at api/jwks.json for
# the official cloud; self-hosted deployments use their own key pair file.
# JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----
JWT_PRIVATE_KEY_PATH=./jwt-private.pem
JWT_PUBLIC_KEY_PATH=./jwks.json
JWT_ACTIVE_KID=key-1
JWT_ISSUER=https://api.yourdomain.com

# --- Auth codes (required, at least 32 UTF-8 bytes) ---
# HMAC secret for hashing email verification / reset / delete codes.
# Generate: openssl rand -hex 32
AUTH_CODE_HMAC_SECRET=

# --- Encrypted database dump (required, Base64 of 32 random bytes) ---
# Startup validates it; without a valid value the server will not start.
# Generate: openssl rand -base64 32
DB_DUMP_KEY=

# --- Tombstone cleanup cron (required for the cleanup endpoint) ---
# The scheduled caller (Vercel Cron, daily 03:00 UTC) must present this
# secret as `Authorization: Bearer <secret>` to GET/POST
# /v1/admin/maintenance/cleanup.
# Generate: openssl rand -hex 32
TOMBSTONE_CLEANUP_SECRET=

# --- Email, SMTP (required when email verification is on) ---
# Any SMTP provider works. The official cloud uses Resend SMTP:
# host smtp.resend.com, port 465 (implicit TLS, SMTP_SECURE=true)
# or 587 (STARTTLS, SMTP_SECURE=false), username "resend",
# password = Resend API key (Sending access only).
# SMTP_FROM must be a bare email address, no display name.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com
SMTP_SECURE=true

# --- Reserved (listed in System Design §8; not read by current code) ---
# Access token TTL is fixed at 15 minutes, refresh token at 30 days.
# JWT_EXPIRES_IN=900
# REFRESH_TOKEN_EXPIRES_IN=2592000
# API_BASE_URL=https://api.yourdomain.com
# AUTH_MODE=standalone

# --- Web client, Vite build-time variables (optional) ---
# VITE_API_BASE_URL=https://api.yourdomain.com
# VITE_GOOGLE_DRIVE_CLIENT_ID=
# VITE_DROPBOX_CLIENT_ID=
# VITE_OAUTH_REDIRECT_URI=https://yourdomain.com/users/me/settings

# --- Local development only (never set in production) ---
# SEALERO_LOCAL_DEV_AUTH=1
# SEALERO_LOCAL_DEV_ADMIN_EMAIL=admin@example.com
# SEALERO_LOCAL_DEV_ADMIN_PASSWORD=
# VITE_API_PROXY_TARGET=http://localhost:3000

# --- Generate a JWT key pair (RS256) ---
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
# node -e "const c=require('node:crypto'),f=require('node:fs');const k=c.createPublicKey(f.readFileSync('jwt-private.pem'));const j=k.export({format:'jwk'});j.kid='key-1';j.alg='RS256';j.use='sig';f.writeFileSync('jwks.json',JSON.stringify({keys:[j]},null,2))"
