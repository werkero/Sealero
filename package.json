{
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@neondatabase/serverless": "^1.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@vercel/analytics": "^2.0.1",
    "argon2": "^0.45.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "hash-wasm": "^4.13.0",
    "hono": "^4.13.9",
    "i18next": "^27.2.2",
    "lucide-react": "^1.78.0",
    "motion": "^14.14.0",
    "nodemailer": "^10.6.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-router-dom": "^7.18.6",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  },
  "name": "sealero-server",
  "packageManager": "pnpm@11.25.0",
  "private": true,
  "scripts": {
    "build": "pnpm build:api && pnpm build:web",
    "build:api": "tsc -p server/tsconfig.build.json",
    "build:web": "tsc -b && vite build",
    "dev": "vite",
    "dev:api": "SEALERO_LOCAL_DEV_AUTH=1 tsx watch server/server.ts",
    "dev:web": "vite",
    "lint": "pnpm lint:web",
    "lint:web": "eslint .",
    "preview": "vite preview",
    "start:api": "SEALERO_LOCAL_DEV_AUTH=1 tsx server/server.ts",
    "test": "pnpm test:api && pnpm test:web",
    "test:api": "vitest run server/test",
    "test:web": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "pnpm typecheck:api && pnpm typecheck:web",
    "typecheck:api": "tsc --noEmit -p server/tsconfig.json",
    "typecheck:web": "tsc -b"
  },
  "type": "module"
}
